{
  "name": "@shieldlabs/svelte",
  "version": "1.0.0",
  "description": "Svelte 5 and SvelteKit bindings for ShieldLabs device intelligence: load the agent once, track its state and get a request ID for every identification.",
  "keywords": [
    "shieldlabs",
    "svelte",
    "sveltekit",
    "device-intelligence",
    "fraud-detection",
    "identification"
  ],
  "homepage": "https://docs.shieldlabs.ai",
  "bugs": {
    "url": "https://github.com/ShieldLabs-ai/shieldlabs-svelte/issues",
    "email": "contact@shieldlabs.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldLabs-ai/shieldlabs-svelte.git"
  },
  "license": "MIT",
  "author": "ShieldLabs Inc. <contact@shieldlabs.ai>",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package --input src/lib --output dist && publint --strict",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@shieldlabs/js": "^1.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sveltejs/package": "2.5.6",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "~4.1.11",
    "eslint": "~9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.24",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "~6.4.3",
    "vitest": "~4.1.11"
  }
}
