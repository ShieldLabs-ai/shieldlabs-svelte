# Temporary: @shieldlabs-ai/js is not on the npm registry yet, so npm cannot install the peer
# dependency automatically. Remove this file once @shieldlabs-ai/js 1.x is published (see CONTRIBUTING.md).
legacy-peer-deps=true
# Lets `npm install --no-save <tarball>` install the packed @shieldlabs-ai/js, which the line above
# would otherwise leave out because the package lists it as a peer dependency.
save-dev=true
